#!/usr/bin/env bash
# Mock `sudo` for tests/e2e: records the invocation and fails by default.
#
# The safety scenarios assert that this file is never reached; the sudo-mode
# scenarios assert that it is. `$MOCK_STATE/sudo_ok` makes a `mount` succeed:
# the mount point (last argument) is recorded in `$MOCK_STATE/sdz1_mp` so the
# lsblk mock can report the device as mounted there.
#
# `$MOCK_STATE/sudo_umount_ok` makes `umount` (also `umount -l`) succeed: the
# recorded mount point is removed again, so the next lsblk report shows the
# device as unmounted. Without the flag `umount` fails like every other call.
set -u

if [ -z "${MOCK_STATE:-}" ]; then
    echo "mock sudo: MOCK_STATE is not set" >&2
    exit 1
fi

printf 'SUDO %s\n' "$*" >>"$MOCK_STATE/calls.log"

if [ "${1:-}" = "mount" ] && [ -f "$MOCK_STATE/sudo_ok" ]; then
    target=""
    for arg in "$@"; do
        target="$arg"
    done
    printf '%s\n' "$target" >"$MOCK_STATE/sdz1_mp"
    echo "MOCK SUDO: mounted $target"
    exit 0
fi

if [ "${1:-}" = "umount" ] && [ -f "$MOCK_STATE/sudo_umount_ok" ]; then
    rm -f "$MOCK_STATE/sdz1_mp"
    echo "MOCK SUDO: unmounted"
    exit 0
fi

echo "MOCK SUDO: refusing (simulated failure)" >&2
exit 1
